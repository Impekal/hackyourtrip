# Kopieren nach .env (wird nicht eingecheckt) und ausfuellen.
# Alle Variablen sind optional - ohne sie laeuft `check` trotzdem, nur ohne
# den jeweiligen Alert-Kanal bzw. mit Mock-Fluegen statt echten (Konsolen-
# Ausgabe funktioniert immer).

# Travelpayouts (Aviasales) Data API (Fluege, echte Preise, empfohlen):
# kostenloses Konto auf https://www.travelpayouts.com -> API-Token im
# Account-Bereich kopieren. Ohne diesen Wert laeuft Flug-Suche auf Mock-Daten
# (oder auf Amadeus, falls unten gesetzt).
TRAVELPAYOUTS_TOKEN=

# Amadeus Self-Service ist seit Juli 2026 abgeschaltet (nur noch Enterprise-
# Vertraege). Nur setzen, falls du einen Amadeus-Enterprise-Zugang hast -
# ansonsten TRAVELPAYOUTS_TOKEN oben nutzen.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Telegram: @BotFather -> /newbot -> Token hier eintragen, dann dem Bot
# einmal schreiben und https://api.telegram.org/bot<TOKEN>/getUpdates
# aufrufen, um die eigene chat_id herauszufinden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP fuer E-Mail-Alerts (z.B. Gmail mit App-Passwort).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
