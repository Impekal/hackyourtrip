# Kopieren nach .env (wird nicht eingecheckt) und ausfuellen.
# Alle Variablen sind optional - ohne sie laeuft `check` trotzdem, nur ohne
# den jeweiligen Alert-Kanal (Konsolen-Ausgabe funktioniert immer).

# Telegram: @BotFather -> /newbot -> Token hier eintragen, dann dem Bot
# einmal schreiben und https://api.telegram.org/bot<TOKEN>/getUpdates
# aufrufen, um die eigene chat_id herauszufinden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP fuer E-Mail-Alerts (z.B. Gmail mit App-Passwort).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
